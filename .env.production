# E-Seller Environment Configuration
# Copier ce fichier vers .env.local

# Database - PostgreSQL Local (Docker)
DATABASE_URL="postgresql://eseller:eseller_password@localhost:5432/eseller"
DIRECT_URL="postgresql://eseller:eseller_password@localhost:5432/eseller"

# Supabase (optionnel)
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# NextAuth
NEXTAUTH_SECRET="e-seller-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (optionnel)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Ollama (local AI) ✅ CONFIGURÉ
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
