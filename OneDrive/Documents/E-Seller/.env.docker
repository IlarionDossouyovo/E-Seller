# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production

# Stripe (Replace with your keys)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
