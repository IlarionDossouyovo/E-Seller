{
  "name": "Seller Stack - Analytics Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "days": 1
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every Day",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://192.168.10.96:11434/api/generate",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3.1:8b"
            },
            {
              "name": "prompt",
              "value": "Génère un rapport analytique simple en français pour un site e-commerce: nombre de commandes, revenus, produits populaires, conseils pour améliorer les ventes. Format JSON."
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        }
      },
      "id": "ai",
      "name": "AI Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "webhook": {
          "body": {
            "message": "Rapport analytique quotidien"
          }
        },
        "method": "POST"
      },
      "id": "notify",
      "name": "Notify",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Every Day": {
      "main": [[{ "node": "AI Analysis", "type": "main", "index": 0 }]]
    },
    "AI Analysis": {
      "main": [[{ "node": "Notify", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "id": "seller-stack-analytics",
  "name": "Seller Stack - Analytics Report",
  "active": false
}
