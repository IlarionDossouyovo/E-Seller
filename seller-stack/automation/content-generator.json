{
  "name": "Seller Stack - Content Generator",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "hours", "hours": 2}]
        }
      },
      "id": "schedule",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://192.168.10.96:11434/api/generate",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "llama3.1:8b"},
            {"name": "prompt", "value": "Génère 3 descriptions de produits e-commerce accrocheuses en français. Format JSON tableau."},
            {"name": "stream", "value": false}
          ]
        }
      },
      "id": "ai",
      "name": "Generate Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "webhook": {"body": {"message": "Contenu généré"}},
        "method": "POST"
      },
      "id": "notify",
      "name": "Notify",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Every 2 Hours": {"main": [[{"node": "Generate Content", "type": "main", "index": 0}]]},
    "Generate Content": {"main": [[{"node": "Notify", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "id": "seller-stack-content",
  "name": "Seller Stack - Content Generator",
  "active": false
}
