{
  "name": "Seller Stack - Inventory Alert",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "hours", "hours": 4}]}},
      "id": "schedule", "name": "Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://192.168.10.96:11434/api/generate",
        "method": "POST", "sendBody": true,
        "bodyParameters": {"parameters": [
          {"name": "model", "value": "llama3.1:8b"},
          {"name": "prompt", "value": "Génère une alerte stock pour 5 produits. Format JSON: produit, stock_actuel, seuil_minimum, action_recommandee."},
          {"name": "stream", "value": false}
        ]}
      },
      "id": "ai", "name": "Check Stock",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [450, 300]
    },
    {"parameters": {"webhook": {"body": {"message": "Alerte stock"}}, "id": "notify", "name": "Notify",
      "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [650, 300]
    }
  ],
  "connections": {
    "Every 4 Hours": {"main": [[{"node": "Check Stock", "type": "main", "index": 0}]]},
    "Check Stock": {"main": [[{"node": "Notify", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "id": "seller-stack-inventory", "name": "Seller Stack - Inventory Alert", "active": false
}
