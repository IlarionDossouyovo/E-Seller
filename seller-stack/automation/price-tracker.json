{
  "name": "Seller Stack - Price Tracker",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "hours", "hours": 6}]}},
      "id": "schedule", "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://192.168.10.96:11434/api/generate",
        "method": "POST", "sendBody": true,
        "bodyParameters": {"parameters": [
          {"name": "model", "value": "llama3.1:8b"},
          {"name": "prompt", "value": "Liste 10 produits avec prix concurrent sur Amazon/AliExpress. Format JSON: produit, prix_fournisseur, prix_concurrent, marge."},
          {"name": "stream", "value": false}
        ]}
      },
      "id": "ai", "name": "Check Prices",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [450, 300]
    },
    {"parameters": {"webhook": {"body": {"message": "Prix mis à jour"}}, "id": "notify", "name": "Notify",
      "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [650, 300]
    }
  ],
  "connections": {
    "Every 6 Hours": {"main": [[{"node": "Check Prices", "type": "main", "index": 0}]]},
    "Check Prices": {"main": [[{"node": "Notify", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "id": "seller-stack-prices", "name": "Seller Stack - Price Tracker", "active": false
}
