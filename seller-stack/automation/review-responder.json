{
  "name": "Seller Stack - Review Responder",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "hours", "hours": 2}]}},
      "id": "schedule", "name": "Check Reviews",
      "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://192.168.10.96:11434/api/generate",
        "method": "POST", "sendBody": true,
        "bodyParameters": {"parameters": [
          {"name": "model", "value": "llama3.1:8b"},
          {"name": "prompt", "value": "Tu es un assistant e-commerce. Génère une réponse professionnelle à un avis client positif. Format: thank you + demande de revenir."},
          {"name": "stream", "value": false}
        ]}
      },
      "id": "ai", "name": "Generate Response",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [450, 300]
    },
    {"parameters": {"webhook": {"body": {"message": "Réponse générée"}}, "id": "notify", "name": "Notify",
      "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [650, 300]
    }
  ],
  "connections": {
    "Check Reviews": {"main": [[{"node": "Generate Response", "type": "main", "index": 0}]]},
    "Generate Response": {"main": [[{"node": "Notify", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "id": "seller-stack-reviews", "name": "Seller Stack - Review Responder", "active": false
}
