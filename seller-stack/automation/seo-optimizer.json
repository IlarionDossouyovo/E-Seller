{
  "name": "Seller Stack - SEO Optimizer",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "days", "days": 1}]
        }
      },
      "id": "schedule",
      "name": "Every Day",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://192.168.10.96:11434/api/generate",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "llama3.1:8b"},
            {"name": "prompt", "value": "Génère 5 suggestions SEO pour améliorer le référencement d'un site e-commerce. Format JSON tableau avec: titre, description, mots-clés, URL."},
            {"name": "stream", "value": false}
          ]
        }
      },
      "id": "ai",
      "name": "SEO Suggestions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "webhook": {"body": {"message": "SEO optimisé"}},
        "method": "POST"
      },
      "id": "notify",
      "name": "Notify",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Every Day": {"main": [[{"node": "SEO Suggestions", "type": "main", "index": 0}]]},
    "SEO Suggestions": {"main": [[{"node": "Notify", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "id": "seller-stack-seo",
  "name": "Seller Stack - SEO Optimizer",
  "active": false
}
